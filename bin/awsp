#!/bin/bash
# AWS Profile Switcher with Auto SSO Validation
# Intelligently switches AWS profiles and validates/renews SSO sessions

set -e

# Configuration
SSO_SESSION="wvrdz"
AWS_CONFIG_FILE="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get list of available profiles
get_profiles() {
    aws configure list-profiles | grep -v default
}

# Check if SSO session is valid
check_sso_session() {
    local profile="$1"
    aws sts get-caller-identity --profile "$profile" &>/dev/null
    return $?
}

# Renew SSO session
renew_sso_session() {
    echo -e "${YELLOW}Renewing SSO session...${NC}"
    aws sso login --sso-session "$SSO_SESSION"
    return $?
}

# Show profile info
show_profile_info() {
    local profile="$1"

    echo -e "\n${BLUE}Profile: $profile${NC}"

    # Get profile configuration
    local account_id=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep sso_account_id | awk '{print $3}')
    local role_name=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep sso_role_name | awk '{print $3}')
    local region=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep region | awk '{print $3}')

    echo -e "Account ID: ${GREEN}$account_id${NC}"
    echo -e "Role: ${GREEN}$role_name${NC}"
    echo -e "Region: ${GREEN}$region${NC}"

    # Get current identity
    if check_sso_session "$profile"; then
        IDENTITY=$(aws sts get-caller-identity --profile "$profile" --output json)
        ARN=$(echo "$IDENTITY" | grep -o '"Arn": "[^"]*' | cut -d'"' -f4)
        echo -e "Identity: ${GREEN}$ARN${NC}"
    fi
}

# List all profiles with their account info
list_profiles() {
    echo -e "${BLUE}Available AWS Profiles:${NC}\n"

    local profiles=$(get_profiles)
    local count=1

    for profile in $profiles; do
        local account_id=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep sso_account_id | awk '{print $3}')
        local role_name=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep sso_role_name | awk '{print $3}')

        # Check if session is valid
        if check_sso_session "$profile" 2>/dev/null; then
            local status="${GREEN}✓${NC}"
        else
            local status="${RED}✗${NC}"
        fi

        printf "%2d. %s %-30s (Account: %s, Role: %s)\n" "$count" "$status" "$profile" "$account_id" "$role_name"
        ((count++))
    done

    echo -e "\n${BLUE}Legend:${NC} ${GREEN}✓${NC} = Valid session | ${RED}✗${NC} = Invalid/expired session"
}

# Interactive profile selection
select_profile_interactive() {
    local profiles=($(get_profiles))
    local count=1

    echo -e "${BLUE}Select a profile:${NC}\n"

    for profile in "${profiles[@]}"; do
        local account_id=$(grep -A5 "^\[profile $profile\]" "$AWS_CONFIG_FILE" | grep sso_account_id | awk '{print $3}')

        if check_sso_session "$profile" 2>/dev/null; then
            local status="${GREEN}✓${NC}"
        else
            local status="${RED}✗${NC}"
        fi

        printf "%2d. %s %s (Account: %s)\n" "$count" "$status" "$profile" "$account_id"
        ((count++))
    done

    echo -e "\n"
    read -p "Enter number (or 'q' to quit): " selection

    if [[ "$selection" == "q" ]]; then
        exit 0
    fi

    if ! [[ "$selection" =~ ^[0-9]+$ ]] || [ "$selection" -lt 1 ] || [ "$selection" -gt "${#profiles[@]}" ]; then
        echo -e "${RED}Invalid selection${NC}"
        exit 1
    fi

    echo "${profiles[$((selection-1))]}"
}

# Main logic
main() {
    local profile=""
    local list_mode=false
    local info_mode=false
    local export_mode=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -l|--list)
                list_mode=true
                shift
                ;;
            -i|--info)
                info_mode=true
                shift
                ;;
            -e|--export)
                export_mode=true
                shift
                ;;
            -h|--help)
                echo "Usage: awsp [OPTIONS] [PROFILE]"
                echo ""
                echo "AWS Profile Switcher with Auto SSO Validation"
                echo ""
                echo "Options:"
                echo "  -l, --list     List all available profiles"
                echo "  -i, --info     Show detailed info about profile"
                echo "  -e, --export   Export AWS_PROFILE environment variable"
                echo "  -h, --help     Show this help message"
                echo ""
                echo "Examples:"
                echo "  awsp                          # Interactive selection"
                echo "  awsp weaver-admin             # Switch to specific profile"
                echo "  awsp -l                       # List all profiles"
                echo "  awsp -i weaver-admin          # Show profile info"
                echo "  eval \$(awsp -e weaver-admin)  # Export profile to environment"
                exit 0
                ;;
            *)
                profile="$1"
                shift
                ;;
        esac
    done

    # List mode
    if [ "$list_mode" = true ]; then
        list_profiles
        exit 0
    fi

    # If no profile specified, use interactive selection
    if [ -z "$profile" ]; then
        profile=$(select_profile_interactive)
    fi

    # Validate profile exists
    if ! get_profiles | grep -q "^$profile$"; then
        echo -e "${RED}Error: Profile '$profile' not found${NC}"
        echo -e "Run 'awsp -l' to see available profiles"
        exit 1
    fi

    # Check and renew session if needed
    if ! check_sso_session "$profile"; then
        echo -e "${YELLOW}SSO session invalid for profile: $profile${NC}"
        renew_sso_session

        # Verify session is now valid
        if ! check_sso_session "$profile"; then
            echo -e "${RED}Failed to establish valid SSO session${NC}"
            exit 1
        fi
    fi

    # Show profile info if requested
    if [ "$info_mode" = true ]; then
        show_profile_info "$profile"
        exit 0
    fi

    # Export mode - output export command
    if [ "$export_mode" = true ]; then
        echo "export AWS_PROFILE=$profile"
        exit 0
    fi

    # Default: Show profile info and export instruction
    echo -e "${GREEN}✓ SSO session valid for profile: $profile${NC}"
    show_profile_info "$profile"

    echo -e "\n${YELLOW}To use this profile, run:${NC}"
    echo -e "  ${BLUE}export AWS_PROFILE=$profile${NC}"
    echo -e "\n${YELLOW}Or set it automatically:${NC}"
    echo -e "  ${BLUE}eval \$(awsp -e $profile)${NC}"
}

main "$@"
